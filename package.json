{
  "name": "herlink",
  "version": "0.3.1",
  "description": "grab any video from YouTube, X, Instagram, TikTok & 1600+ sites — right from your terminal. paste. grab. done.",
  "type": "module",
  "bin": {
    "herlink": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "author": "Wilber Hernan",
  "keywords": [
    "video",
    "downloader",
    "yt-dlp",
    "youtube",
    "instagram",
    "twitter",
    "cli",
    "tui",
    "ink"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilberHernan/Herlink.git"
  },
  "homepage": "https://github.com/WilberHernan/Herlink#readme",
  "bugs": {
    "url": "https://github.com/WilberHernan/Herlink/issues"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
